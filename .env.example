# Formulario de Google que recibe los correos de quienes descargan la plantilla.
# Si falta VITE_LEAD_FORM_ACTION o VITE_LEAD_FORM_EMAIL_ENTRY, la landing descarga
# la plantilla directo, sin pedir el correo. Vite las incrusta al compilar.

# URL de envío: https://docs.google.com/forms/d/e/<ID>/formResponse
VITE_LEAD_FORM_ACTION=

# Identificador del campo de correo: entry.1234567890
VITE_LEAD_FORM_EMAIL_ENTRY=

# (Opcional) Identificador del campo de consentimiento: entry.1234567890
VITE_LEAD_FORM_CONSENT_ENTRY=

# (Opcional) Valor que se envía en el consentimiento. Por defecto "Sí".
# Si el campo es de casillas, debe ser EXACTAMENTE el texto de la opción
# (por ejemplo "Si" sin tilde); si no coincide, Google responde 400.
VITE_LEAD_FORM_CONSENT_VALUE=

# ---------------------------------------------------------------------------
# Embudo: Pixel de Meta, API de Conversiones y MailerLite
# ---------------------------------------------------------------------------

# Id del Pixel de Meta (es público). Si falta, no se carga el Pixel ni se
# envían eventos a la API de Conversiones; GA4 sigue funcionando.
VITE_META_PIXEL_ID=

# Las variables siguientes son SECRETAS y las leen las funciones de Netlify
# (netlify/functions). Configúralas en el panel de Netlify (Site configuration
# > Environment variables) y, para probar en local con `npx netlify dev`,
# en el .env. No llevan prefijo VITE_ para que nunca lleguen al navegador.

# Mismo id del Pixel, leído por la función capi.
META_PIXEL_ID=

# Token de acceso de la API de Conversiones (Events Manager > Configuración).
META_CAPI_TOKEN=

# (Opcional) Código de "Probar eventos" de Events Manager. Mientras exista,
# los eventos del servidor NO cuentan como reales. Quítalo al lanzar.
META_TEST_EVENT_CODE=

# (Opcional) Versión de la Graph API. Por defecto v25.0.
META_GRAPH_VERSION=

# Token de la API de MailerLite (Integraciones > API) y id del grupo
# "Reto 3 días", que dispara la automatización de correos.
MAILERLITE_API_TOKEN=
MAILERLITE_GROUP_ID=
