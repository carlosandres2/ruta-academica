# Formulario de Google que recibe los correos de quienes descargan la plantilla.
# Si falta VITE_LEAD_FORM_ACTION o VITE_LEAD_FORM_EMAIL_ENTRY, la landing descarga
# la plantilla directo, sin pedir el correo. Vite las incrusta al compilar.

# URL de envío: https://docs.google.com/forms/d/e/<ID>/formResponse
VITE_LEAD_FORM_ACTION=

# Identificador del campo de correo: entry.1234567890
VITE_LEAD_FORM_EMAIL_ENTRY=

# (Opcional) Identificador del campo de consentimiento: entry.1234567890
VITE_LEAD_FORM_CONSENT_ENTRY=

# (Opcional) Valor que se envía en el consentimiento. Por defecto "Sí".
# Si el campo es de casillas, debe ser EXACTAMENTE el texto de la opción
# (por ejemplo "Si" sin tilde); si no coincide, Google responde 400.
VITE_LEAD_FORM_CONSENT_VALUE=
